APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Autenticación SPA (Laravel Sanctum): dominios que reciben cookies de sesión.
# Con el proxy de Vite en desarrollo el origen del navegador es localhost:5173
# (o 127.0.0.1:5173). Si falta esta variable, config/sanctum.php ya incluye esos
# orígenes de desarrollo por defecto, pero en producción debe fijarse aquí.
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

# Orígenes admitidos por CORS (separados por comas). En desarrollo, con proxy
# de Vite, no se ejercita; línea base segura para despliegues sin proxy.
# No usar "*" junto a credenciales.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Cuentas de desarrollo para `php artisan db:seed` (solo entorno local).
# Generar valores con: openssl rand -hex 16
DEV_SEED_ADMIN_PASSWORD=
DEV_SEED_AGENT_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
