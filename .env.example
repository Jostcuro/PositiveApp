# Nombre de la base de datos de desarrollo
MYSQL_DATABASE=positive_whatsapp
# Usuario de aplicación (solo desarrollo local)
MYSQL_USER=positive
# Generar un valor aleatorio y copiarlo tambien a backend/.env (DB_PASSWORD).
# Ejemplo para generarlo:  openssl rand -hex 24
MYSQL_PASSWORD=cambiar_por_valor_aleatorio
# Contraseña root del contenedor MySQL (solo dev). Mismo tratamiento que MYSQL_PASSWORD.
MYSQL_ROOT_PASSWORD=cambiar_por_valor_aleatorio
# Puerto expuesto en 127.0.0.1 del host
MYSQL_PORT=3306